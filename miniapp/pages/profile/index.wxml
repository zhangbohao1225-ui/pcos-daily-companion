<view class="page profile-page">
  <view class="profile-hero"><view class="hero-glow glow-one"></view><view class="hero-glow glow-two"></view><view class="profile-row"><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image class="avatar" src="{{avatarUrl || '/assets/tutu-single.svg'}}" mode="aspectFill"/></button><view class="profile-copy"><view class="profile-name">{{displayName || 'SUTA 用户'}}</view><view class="profile-id">{{publicId ? 'ID ' + publicId : '正在生成专属 ID…'}}</view><view class="profile-caption">我的私密健康空间</view></view></view><view class="profile-actions"><button bindtap="toggleProfileEditor">{{showProfileEditor ? '收起编辑' : '编辑资料'}}</button><view class="profile-safety">只展示你主动公开的内容</view></view></view>

  <view class="card" style="display:flex;text-align:center"><view style="flex:1" data-type="following" bindtap="goConnections"><view style="font-size:34rpx;font-weight:700">{{followingCount}}</view><text>关注 ›</text></view><view style="flex:1" data-type="followers" bindtap="goConnections"><view style="font-size:34rpx;font-weight:700">{{followerCount}}</view><text>粉丝 ›</text></view></view>
  <view class="card profile-editor" wx:if="{{showProfileEditor}}"><view class="section-title">编辑个人资料</view><view class="label">昵称</view><input class="input" type="nickname" maxlength="20" value="{{displayName}}" bindinput="setName" placeholder="输入昵称"/><button class="primary-btn" bindtap="saveNickname">保存昵称</button></view>

  <view class="menu-card"><button bindtap="goMessages"><image class="menu-art" src="/assets/menu-message.svg" mode="aspectFit"/><view class="menu-copy"><view>私信消息</view><text>查看同伴发来的温柔消息</text></view><view class="badge" wx:if="{{unreadMessages}}">{{unreadMessages}}</view><view class="arrow">›</view></button><button bindtap="goMyForum"><image class="menu-art" src="/assets/menu-forum.svg" mode="aspectFit"/><view class="menu-copy"><view>我的论坛帖</view><text>查看自己的发布和互动消息</text></view><view class="badge" wx:if="{{unread}}">{{unread}}</view><view class="arrow">›</view></button><button bindtap="goWallet"><image class="menu-art" src="/assets/menu-wallet.svg" mode="aspectFit"/><view class="menu-copy"><view>钱包与 SUTA Pro</view><text>余额、充值与会员内容</text></view><view class="arrow">›</view></button><button bindtap="toggleGoals"><image class="menu-art" src="/assets/menu-goal.svg" mode="aspectFit"/><view class="menu-copy"><view>健康目标</view><text>设置睡眠和每日活动目标</text></view><view class="arrow">›</view></button><button bindtap="goSettings"><image class="menu-art" src="/assets/menu-settings.svg" mode="aspectFit"/><view class="menu-copy"><view>设置与反馈</view><text>主题色、反馈中心和账户设置</text></view><view class="arrow">›</view></button></view>

  <view class="card goal-settings" wx:if="{{showGoals}}"><view class="section-title">健康目标</view><view class="label">每晚睡眠目标</view><picker range="{{sleepOptions}}" bindchange="setSleep"><view class="input picker">{{sleepTarget}} 小时</view></picker><view class="label">每日活动目标</view><picker range="{{movementOptions}}" bindchange="setMovement"><view class="input picker">{{movementTarget}} 分钟</view></picker><view class="custom-title">自定义目标</view><view class="custom-goal" wx:for="{{customGoals}}" wx:key="id"><text>{{item.name}} · {{item.target}}{{item.unit}}</text><button data-id="{{item.id}}" bindtap="removeCustomGoal">删除</button></view><input class="input" value="{{newGoalName}}" bindinput="setNewGoalName" placeholder="目标名称"/><view class="goal-input-row"><input class="input" type="digit" value="{{newGoalValue}}" bindinput="setNewGoalValue" placeholder="数值"/><input class="input" value="{{newGoalUnit}}" bindinput="setNewGoalUnit" placeholder="单位"/></view><button class="secondary-btn" bindtap="addCustomGoal">添加目标</button><button class="primary-btn" bindtap="saveGoals">保存全部目标</button></view>

  <view class="menu-card compact"><button bindtap="exportData"><view class="compact-symbol">⇩</view><view class="menu-copy"><view>导出本机健康数据</view><text>生成完整 JSON 备份</text></view><view class="arrow">›</view></button><button data-type="privacy" bindtap="goLegal"><view class="compact-symbol">盾</view><view class="menu-copy"><view>隐私协议</view></view><view class="arrow">›</view></button><button data-type="service" bindtap="goLegal"><view class="compact-symbol">文</view><view class="menu-copy"><view>服务协议</view></view><view class="arrow">›</view></button></view>

  <button class="logout-button" bindtap="logout"><text>退出登录</text><view>清除本机账户缓存</view></button><view class="disclaimer">SUTA 提供健康记录和一般性科普，不替代医疗诊断或治疗建议。</view>
</view>
