.profile-page { min-height:100vh; background:linear-gradient(180deg,#fff8f6,#fbf6ff 48%,#fffdfa); }.profile-hero { position:relative; overflow:hidden; padding:32rpx; border:1rpx solid #f0d9df; border-radius:38rpx; background:linear-gradient(135deg,#ffe4e5,#f2eaff); box-shadow:0 20rpx 46rpx rgba(120,75,92,.12); }.hero-glow { position:absolute; border-radius:50%; opacity:.45; }.glow-one { top:-80rpx; right:-50rpx; width:240rpx; height:240rpx; background:#ffcbd1; }.glow-two { bottom:-110rpx; left:90rpx; width:230rpx; height:230rpx; background:#d7caee; }.profile-row { position:relative; display:flex; align-items:center; gap:24rpx; }.avatar-button { box-sizing:border-box; width:142rpx; min-width:142rpx; height:142rpx; flex:none; padding:0; margin:0; overflow:hidden; border:8rpx solid rgba(255,255,255,.92); border-radius:50%; background:#fff; box-shadow:0 12rpx 30rpx rgba(122,73,79,.15); }.avatar-button::after,.menu-card button::after,.custom-goal button::after,.profile-actions button::after { border:0; }.avatar { display:block; width:126rpx; height:126rpx; border-radius:50%; }.profile-copy { position:relative; min-width:0; flex:1; padding-right:4rpx; }.profile-name { overflow:hidden; color:#694744; font-size:36rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }.profile-id { margin-top:7rpx; overflow:hidden; color:#bf686a; font-size:19rpx; letter-spacing:.5rpx; text-overflow:ellipsis; white-space:nowrap; }.profile-caption { margin-top:9rpx; color:#92716d; font-size:22rpx; }.profile-actions { position:relative; display:flex; align-items:center; justify-content:space-between; margin-top:26rpx; padding-top:20rpx; border-top:1rpx solid rgba(189,129,142,.2); }.profile-actions button { width:auto; min-width:150rpx; margin:0; padding:8rpx 20rpx; border:1rpx solid #e6b8b8; border-radius:999rpx; background:rgba(255,255,255,.76); color:#b55d60; font-size:21rpx; line-height:1.7; }.profile-safety { color:#9c7d79; font-size:19rpx; }.profile-editor,.goal-settings { margin-top:24rpx; }.label { margin:20rpx 0 10rpx; color:#93716c; font-size:22rpx; }.input { box-sizing:border-box; width:100%; padding:18rpx; border:1rpx solid #ead9d4; border-radius:18rpx; background:#fffaf8; }.profile-editor .primary-btn,.goal-settings .primary-btn { margin-top:20rpx; }.menu-card { margin-top:26rpx; padding:6rpx 22rpx; border:1rpx solid #f2e5e1; border-radius:32rpx; background:rgba(255,255,255,.94); box-shadow:0 14rpx 36rpx rgba(100,66,63,.07); }.menu-card button { display:flex; align-items:center; box-sizing:border-box; width:100%; min-height:126rpx; margin:0; padding:18rpx 0; border-bottom:1rpx solid #f3e8e4; background:transparent; color:#75534f; text-align:left; }.menu-card button:last-child { border-bottom:0; }.menu-art { width:78rpx; height:78rpx; flex:none; }.menu-copy { min-width:0; flex:1; margin-left:18rpx; }.menu-copy view { overflow:hidden; font-size:27rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }.menu-copy text { display:block; margin-top:5rpx; overflow:hidden; color:#a98781; font-size:20rpx; text-overflow:ellipsis; white-space:nowrap; }.arrow { margin-left:12rpx; color:#b99b96; font-size:40rpx; }.badge { min-width:34rpx; height:34rpx; padding:0 7rpx; border-radius:999rpx; background:#e2575f; color:#fff; font-size:19rpx; line-height:34rpx; text-align:center; }.custom-title { margin:24rpx 0 12rpx; font-weight:700; }.custom-goal { display:flex; justify-content:space-between; align-items:center; margin:10rpx 0; padding:14rpx; border-radius:16rpx; background:#fff4f0; }.custom-goal button { width:auto; margin:0; padding:0 8rpx; background:transparent; color:#c25c5e; font-size:20rpx; }.goal-input-row { display:grid; grid-template-columns:1fr 1fr; gap:12rpx; margin-top:12rpx; }.goal-settings>.input { margin-top:12rpx; }.goal-settings .secondary-btn { margin-top:14rpx; }.compact button { min-height:96rpx; }.compact-symbol { display:flex; width:58rpx; height:58rpx; flex:none; align-items:center; justify-content:center; border-radius:18rpx; background:#fff0ed; color:#bd6565; font-size:20rpx; font-weight:700; }.compact .menu-copy { margin-left:16rpx; }.logout-button { box-sizing:border-box; width:100%; margin-top:28rpx; padding:19rpx; border:1rpx solid #efc7c6; border-radius:26rpx; background:#fff0ef; color:#bd575c; line-height:1.4; }.logout-button text { display:block; font-size:26rpx; font-weight:700; }.logout-button view { margin-top:3rpx; color:#bd8582; font-size:18rpx; }.disclaimer { padding:30rpx 16rpx; color:#a1847e; font-size:20rpx; line-height:1.6; text-align:center; }
