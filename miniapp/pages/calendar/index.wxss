.summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 28rpx; }.summary { padding: 28rpx; border-radius: 28rpx; background: linear-gradient(145deg,#fff,#fff0eb); text-align: center; color: #9f7b75; font-size: 22rpx; }.summary text { display: block; margin-bottom: 6rpx; color: #ca6765; font-family: "Microsoft YaHei", "微软雅黑", sans-serif; font-size: 48rpx; font-weight: 700; }
.legend { display: flex; gap: 8rpx; }.dot { width: 20rpx; height: 20rpx; border-radius: 6rpx; }.calendar-grid { display: grid; grid-template-columns: repeat(5,1fr); gap: 10rpx; margin-top: 24rpx; }.day { display: flex; min-height: 86rpx; padding: 12rpx 4rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 16rpx; color: #9b7c76; }.day text { font-size: 18rpx; }.day-count { margin-top: 5rpx; font-size: 20rpx; font-weight: 700; }.low { background: #f8efec; }.mid { background: #ffdcd2; }.high { background: #ee9890; color: #fff; }.tip { margin-top: 20rpx; padding: 24rpx; border-radius: 24rpx; background: #fff3ee; color: #936e68; line-height: 1.8; }
.cycle-mark { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 22rpx; background: #fff0eb; color: #d66e70; font-size: 42rpx; }
.cycle-meta { display: flex; gap: 12rpx; margin-top: 22rpx; }.cycle-meta text { padding: 9rpx 14rpx; border-radius: 999rpx; background: #fff6f2; color: #a4746d; font-size: 20rpx; }
.phase-legend { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }.phase-legend text { position: relative; padding-left: 20rpx; color: #93716b; font-size: 19rpx; }.phase-legend text::before { position: absolute; top: 8rpx; left: 0; width: 12rpx; height: 12rpx; border-radius: 50%; content: ""; }.menstrual-dot::before { background: #da7376; }.follicular-dot::before { background: #8eb69a; }.ovulation-dot::before { background: #e8ae55; }.luteal-dot::before { background: #a98bc0; }
.prediction-scroll { width: 100%; margin-top: 22rpx; white-space: nowrap; }.prediction-row { display: inline-flex; gap: 10rpx; padding: 4rpx 4rpx 12rpx; }.prediction-day { display: inline-flex; width: 92rpx; min-height: 132rpx; padding: 13rpx 6rpx; flex-direction: column; align-items: center; border: 2rpx solid transparent; border-radius: 22rpx; }.prediction-day.today { border-color: #dc7b7c; }.prediction-day .week { font-size: 17rpx; opacity: .76; }.prediction-day .number { margin-top: 7rpx; font-size: 31rpx; font-weight: 700; }.prediction-day .phase-name { margin-top: 7rpx; font-size: 17rpx; }.prediction-day.menstrual { background: #fff0ec; color: #bb5d61; }.prediction-day.follicular { background: #eef7ef; color: #65836b; }.prediction-day.ovulation { background: #fff5df; color: #a97830; }.prediction-day.luteal { background: #f5eff9; color: #806a96; }
.prediction-note,.prediction-empty { margin-top: 18rpx; padding: 20rpx; border-radius: 20rpx; background: #fff8f5; color: #9b7871; font-size: 20rpx; line-height: 1.7; }
.period-control { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 24rpx; overflow: hidden; background: linear-gradient(135deg,#fff1ef,#fff8f4 58%,#f5efff); }
.period-control-art { width: 210rpx; height: 184rpx; flex: none; }
.period-control-copy { min-width: 0; flex: 1; }
.period-control-btn { width: 100%; min-height: 68rpx; margin-top: 18rpx; border-radius: 20rpx; font-size: 23rpx; }
