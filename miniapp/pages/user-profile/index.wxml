<view class="page public-page">
  <view class="loading-state" wx:if="{{loading}}"><image src="/assets/tutu-single.svg" mode="aspectFit"/><view>正在打开同伴的小空间…</view></view>
  <view class="unavailable" wx:elif="{{unavailable}}"><image src="/assets/tutu-forum-painted.png" mode="aspectFit"/><view class="state-title">这位同伴的主页还没准备好</view><view class="state-copy">可能是资料刚刚更新，请稍后再试。这里不会显示后台错误信息。</view><button bindtap="load">再试一次</button><button class="ghost" bindtap="goForum">返回论坛</button></view>
  <block wx:else>
    <view class="profile-hero"><view class="hero-orb orb-one"></view><view class="hero-orb orb-two"></view><image class="profile-avatar" src="{{profile.avatarUrl || '/assets/tutu-single.svg'}}" mode="aspectFill"/><view class="profile-name">{{profile.displayName}}</view><view class="profile-id">{{profile.publicId}}</view><view class="profile-bio">{{profile.bio || '愿每一次记录，都更靠近真实的自己。'}}</view><view class="profile-stats"><view><text>{{followingCount}}</text><text>关注</text></view><view><text>{{followerCount}}</text><text>粉丝</text></view><view><text>{{posts.length}}</text><text>公开分享</text></view></view><view class="social-actions" wx:if="{{!isSelf}}"><button class="follow {{isFollowing ? 'followed' : ''}}" loading="{{socialLoading}}" bindtap="toggleFollow">{{isFollowing ? '已关注' : '+ 关注'}}</button><button class="message" bindtap="message">私信</button></view><view class="self-hint" wx:else>这是你的公开主页</view></view>
    <view class="section-head"><view><text>SUTA MOMENTS</text><view>同伴的公开分享</view></view><image src="/assets/tutu-forum-painted.png" mode="aspectFit"/></view>
    <view class="post-card" wx:for="{{posts}}" wx:key="id" wx:for-item="post"><view class="post-meta"><text>{{post.category || '日常分享'}}</text><text>{{post.createdText}}</text></view><view class="post-content">{{post.content}}</view><view class="post-images count-{{post.images.length}}" wx:if="{{post.images.length}}"><image wx:for="{{post.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-src="{{item}}" data-urls="{{post.images}}" bindtap="preview"/></view><view class="post-likes">♡ {{post.likeCount || 0}}</view></view>
    <view class="empty-posts" wx:if="{{!posts.length}}"><image src="/assets/tutu-forum-painted.png" mode="aspectFit"/><view>这位同伴还没有公开分享</view></view>
  </block>
</view>
