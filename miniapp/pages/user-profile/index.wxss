.public-page { min-height:100vh; background:linear-gradient(180deg,#fff8f7 0%,#fbf6ff 55%,#fffdfa 100%); }.loading-state,.unavailable { display:flex; min-height:70vh; flex-direction:column; align-items:center; justify-content:center; color:#98746f; text-align:center; }.loading-state image { width:180rpx; height:220rpx; margin-bottom:20rpx; }.unavailable image { width:240rpx; height:190rpx; }.state-title { margin-top:18rpx; color:#714e4a; font-size:31rpx; font-weight:800; }.state-copy { max-width:520rpx; margin:14rpx auto 28rpx; color:#a1817c; font-size:23rpx; line-height:1.7; }.unavailable button { width:300rpx; background:#df7370; color:#fff; font-size:24rpx; }.unavailable .ghost { margin-top:12rpx; background:#fff0ed; color:#b86160; }.profile-hero { position:relative; overflow:hidden; padding:44rpx 34rpx 30rpx; border:1rpx solid #f1d8df; border-radius:38rpx; background:linear-gradient(145deg,#ffe9ea,#f4edff); text-align:center; box-shadow:0 20rpx 48rpx rgba(125,77,98,.10); }.hero-orb { position:absolute; border-radius:50%; opacity:.42; }.orb-one { top:-60rpx; right:-30rpx; width:210rpx; height:210rpx; background:#ffc7cf; }.orb-two { bottom:-90rpx; left:-50rpx; width:230rpx; height:230rpx; background:#dcd1f3; }.profile-avatar { position:relative; width:154rpx; height:154rpx; border:8rpx solid rgba(255,255,255,.92); border-radius:50%; background:#fff; box-shadow:0 12rpx 32rpx rgba(128,75,78,.14); }.profile-name { position:relative; margin-top:18rpx; color:#6d4946; font-size:36rpx; font-weight:800; }.profile-id { position:relative; margin-top:7rpx; color:#c66e6d; font-size:20rpx; letter-spacing:1rpx; }.profile-bio { position:relative; margin:16rpx auto 0; color:#916f6b; font-size:24rpx; line-height:1.7; }.profile-stats { position:relative; display:grid; grid-template-columns:repeat(3,1fr); margin-top:28rpx; padding-top:22rpx; border-top:1rpx solid rgba(189,133,145,.22); }.profile-stats view { display:flex; flex-direction:column; }.profile-stats view+view { border-left:1rpx solid rgba(189,133,145,.22); }.profile-stats text:first-child { color:#bd6566; font-size:27rpx; font-weight:800; }.profile-stats text:last-child { margin-top:4rpx; color:#9e807b; font-size:19rpx; }.social-actions { position:relative; display:grid; grid-template-columns:1fr 1fr; gap:18rpx; margin-top:25rpx; }.social-actions button { width:100%; margin:0; border-radius:999rpx; font-size:23rpx; line-height:72rpx; }.social-actions button::after { border:0; }.social-actions .follow { background:#dd6f70; color:#fff; }.social-actions .followed { background:#fff; color:#ad7472; box-shadow:inset 0 0 0 1rpx #e7c7c5; }.social-actions .message { background:#7c6ab0; color:#fff; }.self-hint { position:relative; margin-top:22rpx; color:#a47f7a; font-size:20rpx; }.section-head { display:flex; align-items:center; justify-content:space-between; margin:34rpx 6rpx 8rpx; }.section-head text { color:#cb7473; font-size:18rpx; font-weight:700; letter-spacing:3rpx; }.section-head view view { margin-top:5rpx; color:#6f4e4a; font-size:30rpx; font-weight:800; }.section-head image { width:110rpx; height:82rpx; }.post-card { margin-top:18rpx; padding:28rpx; border:1rpx solid #f3e2dd; border-radius:30rpx; background:rgba(255,255,255,.94); box-shadow:0 12rpx 34rpx rgba(103,69,66,.06); }.post-meta { display:flex; justify-content:space-between; color:#ad8983; font-size:20rpx; }.post-meta text:first-child { padding:6rpx 13rpx; border-radius:999rpx; background:#fff0ed; color:#c46766; }.post-content { margin-top:18rpx; color:#70504c; font-size:27rpx; line-height:1.75; }.post-images { display:grid; grid-template-columns:repeat(3,1fr); gap:8rpx; margin-top:18rpx; }.post-images.count-1 { grid-template-columns:1fr; }.post-images.count-2 { grid-template-columns:1fr 1fr; }.post-images image { width:100%; height:190rpx; border-radius:18rpx; }.post-images.count-1 image { height:360rpx; }.post-likes { margin-top:18rpx; color:#d36b70; font-size:23rpx; }.empty-posts { padding:60rpx 20rpx; color:#9c7b76; text-align:center; }.empty-posts image { width:200rpx; height:150rpx; }
