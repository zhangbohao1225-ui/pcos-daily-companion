.card { margin-bottom:24rpx; }.themes { display:grid; grid-template-columns:repeat(3,1fr); gap:14rpx; margin-top:24rpx; }.theme { margin:0; padding:20rpx 8rpx; background:#fff; color:#795955; font-size:22rpx; border:1rpx solid #eee0dc; }.theme::after { border:0; }.theme.active { border:3rpx solid #d77a75; }.swatch { width:44rpx; height:44rpx; margin:0 auto 10rpx; border-radius:50%; }.feedback .muted { margin:14rpx 0 20rpx; line-height:1.6; }.feedback textarea,.feedback input { box-sizing:border-box; width:100%; margin-top:14rpx; padding:20rpx; border:1rpx solid #ead7d1; border-radius:20rpx; background:#fffaf8; }.feedback textarea { height:220rpx; }.feedback .primary-btn { margin-top:22rpx; }.links { padding-top:8rpx; padding-bottom:8rpx; }.links button { display:flex; justify-content:space-between; width:100%; padding:24rpx 4rpx; background:transparent; color:#72524e; font-size:27rpx; text-align:left; border-bottom:1rpx solid #f2e6e2; }.links button::after { border:0; }.links text { color:#ba9993; }.logout { margin-top:30rpx; background:#fff0ee; color:#c2585c; font-size:25rpx; }
