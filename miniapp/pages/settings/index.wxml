<view class="page"><view class="card"><view class="section-title">主题颜色</view><view class="themes"><button wx:for="{{themes}}" wx:key="id" class="theme {{selected === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseTheme"><view class="swatch" style="background:{{item.color}}"></view>{{item.name}}</button></view></view><view class="card feedback"><view class="section-title">反馈中心</view><view class="muted">告诉我们哪里需要改进。提交后管理员可在腾讯云 CloudBase 数据库的 feedback 集合中查看。</view><textarea maxlength="500" value="{{feedback}}" bindinput="setFeedback" placeholder="请描述你遇到的问题或建议…"/><input value="{{contact}}" bindinput="setContact" placeholder="联系方式（选填）"/><button class="primary-btn" loading="{{sending}}" bindtap="submit">提交反馈</button></view><view class="card links"><button data-type="privacy" bindtap="legal">隐私协议 <text>›</text></button><button data-type="service" bindtap="legal">服务协议 <text>›</text></button></view><button class="logout" bindtap="logout">退出并清除本机账户缓存</button></view>
