.brand-row { display: flex; align-items: center; gap: 16rpx; padding: 4rpx 4rpx 24rpx; }
.brand-mark { width: 74rpx; height: 74rpx; padding: 5rpx; border: 4rpx solid #fff; border-radius: 24rpx; background: linear-gradient(145deg,#fff7f8,#fbe7ec); box-shadow: 0 8rpx 22rpx rgba(197,92,105,.16); }
.brand-copy { flex: 1; }
.brand-name { color: #b95362; font-family: "Microsoft YaHei", "微软雅黑", sans-serif; font-size: 35rpx; font-weight: 800; letter-spacing: 5rpx; }
.brand-copy text { color: #a9807a; font-size: 20rpx; }
.daily-hero { position: relative; display: flex; min-height: 276rpx; overflow: hidden; border: 2rpx solid rgba(255,255,255,.84); border-radius: 34rpx; background: linear-gradient(135deg,#ed7881 0%,#e76f7a 58%,#f2a0a7 100%); box-shadow: 0 20rpx 48rpx rgba(192,77,90,.20); }
.daily-hero::after { position: absolute; z-index: 1; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(90deg,rgba(226,99,113,.98) 0%,rgba(229,105,118,.93) 43%,rgba(235,122,134,.45) 68%,rgba(244,164,170,.18) 100%); content: ""; }
.daily-background { position: absolute; z-index: 0; top: 0; right: 0; width: 66%; height: 100%; opacity: .86; }
.daily-copy { position: relative; z-index: 2; width: 78%; padding: 36rpx 8rpx 32rpx 32rpx; }
.daily-kicker { color: rgba(255,255,255,.88); font-size: 21rpx; font-weight: 800; letter-spacing: 4rpx; }
.daily-title { margin-top: 14rpx; color: #fff; font-family: "Microsoft YaHei", "微软雅黑", sans-serif; font-size: 34rpx; font-weight: 700; line-height: 1.3; white-space: nowrap; text-shadow: 0 3rpx 8rpx rgba(125,50,61,.16); }
.daily-subtitle { margin-top: 18rpx; color: rgba(255,255,255,.88); font-size: 22rpx; line-height: 1.55; }
.welcome-card { display: flex; align-items: center; gap: 20rpx; margin-top: 22rpx; padding: 28rpx 30rpx; border: 1rpx solid #f1ded8; border-radius: 30rpx; background: linear-gradient(135deg,#fffdfb,#fff3ee); box-shadow: 0 14rpx 36rpx rgba(178,82,87,.07); }
.welcome-copy { flex: 1; }
.welcome-title { margin: 10rpx 0 8rpx; color: #704441; font-family: "Microsoft YaHei", "微软雅黑", sans-serif; font-size: 35rpx; font-weight: 700; }
.score { display: flex; align-items: baseline; justify-content: center; width: 116rpx; height: 116rpx; padding-top: 27rpx; border: 4rpx solid #ed8b8f; border-radius: 50%; background: #fff; color: #c85e69; font-family: "Microsoft YaHei", "微软雅黑", sans-serif; font-size: 42rpx; font-weight: 700; }
.score-unit { margin-left: 4rpx; font-family: sans-serif; font-size: 18rpx; }
.progress { height: 12rpx; margin: 26rpx 0 12rpx; overflow: hidden; border-radius: 99rpx; background: #f8e4df; }
.progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#ed8a80,#da686a); }
.checkin-link-btn { min-width: 126rpx; min-height: 58rpx; padding: 0 22rpx; border: 2rpx solid #dc706d; border-radius: 999rpx; background: #fff4f0; box-shadow: 0 8rpx 18rpx rgba(207,94,98,.14); color: #c85e5e; font-size: 23rpx; font-weight: 700; line-height: 58rpx; }
.task-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 24rpx; }
.task { position: relative; display: grid; grid-template-columns: 100rpx 1fr; gap: 4rpx 12rpx; min-height: 112rpx; padding: 12rpx 42rpx 12rpx 8rpx; align-items: center; border: 1rpx solid #f5d8d1; border-radius: 22rpx; background: #fffaf8; color: #795653; font-size: 24rpx; box-shadow: 0 7rpx 18rpx rgba(181,93,91,.05); }
.task.done { background: linear-gradient(145deg,#fff0eb,#f8edff); }
.task-icon { grid-row: span 2; }
.task-art { width: 100rpx; height: 94rpx; border-radius: 18rpx; background: transparent; }
.task-state { color: #c16d67; font-size: 20rpx; }
.task-arrow { position: absolute; top: 50%; right: 16rpx; color: #ce7973; font-size: 34rpx; transform: translateY(-50%); }
.block-title { margin: 38rpx 4rpx 18rpx; }
.shortcut-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.shortcut { display: flex; min-height: 190rpx; padding: 24rpx; flex-direction: column; border: 1rpx solid rgba(255,255,255,.8); border-radius: 28rpx; box-shadow: 0 10rpx 24rpx rgba(134,95,120,.06); }
.coral { background: linear-gradient(145deg,#ffe9e4,#fff6f2); }
.cream { background: linear-gradient(145deg,#fff0da,#fff9ea); }
.lilac { background: linear-gradient(145deg,#eee8fa,#faf7ff); }
.peach { background: linear-gradient(145deg,#ffefe8,#fff8f4); }
.tutu-project { position: relative; display: flex; align-items: center; justify-content: center; flex: none; border: 2rpx solid rgba(255,255,255,.95); background: linear-gradient(145deg,#fff,#ffe9ed); box-shadow: 0 7rpx 16rpx rgba(178,82,100,.13); }
.tutu-project image { display: block; width: 82%; height: 88%; }
.tutu-project > image { transition: transform .18s ease; }
.tutu-outfit { position: absolute; z-index: 2; pointer-events: none; }
.tutu-prop { position: absolute; z-index: 2; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none; }
.tutu-task { width: 58rpx; height: 58rpx; border-radius: 19rpx; }
.big-icon { width: 140rpx; height: 112rpx; border-radius: 24rpx; }
.scene-art { align-self: flex-start; background: transparent; filter: drop-shadow(0 7rpx 12rpx rgba(150,92,102,.10)); }
.team-art,.forum-art { width: 154rpx; }
.period-tool { position: relative; display: grid; min-height: 166rpx; grid-column: 1 / -1; grid-template-columns: 176rpx 1fr; grid-template-rows: auto auto; align-items: center; overflow: hidden; background: linear-gradient(135deg,#ffe8e7,#fff5f0 52%,#f7edff); }
.period-tool .period-art { width: 164rpx; height: 138rpx; grid-row: 1 / 3; align-self: center; }
.period-tool .shortcut-title { align-self: end; margin-top: 0; }
.period-tool .shortcut-copy { align-self: start; padding-right: 66rpx; }
.education-tool { display: grid; min-height: 166rpx; grid-column: 1 / -1; grid-template-columns: 176rpx 1fr; grid-template-rows: auto auto; align-items: center; }
.education-tool .scene-art { width: 164rpx; height: 138rpx; grid-row: 1 / 3; align-self: center; }
.education-tool .shortcut-title { align-self: end; margin-top: 0; }
.education-tool .shortcut-copy { align-self: start; padding-right: 66rpx; }
.shortcut-arrow { position: absolute; right: 24rpx; bottom: 28rpx; color: #bf696b; font-size: 21rpx; font-weight: 700; }
.tutu-nutrition > image { transform: translateX(4rpx) rotate(2deg); }
.tutu-nutrition .tutu-outfit { bottom: 17%; left: 35%; width: 34%; height: 37%; border: 2rpx solid #d59457; border-radius: 45% 45% 25% 25%; background: #fff0d2; }
.tutu-nutrition .tutu-outfit::before { position: absolute; top: -24%; left: 8%; width: 78%; height: 31%; border: 2rpx solid #d59457; border-bottom: 0; border-radius: 99rpx 99rpx 0 0; content: ''; }
.tutu-nutrition .tutu-outfit::after { position: absolute; right: 22%; bottom: 17%; width: 50%; height: 24%; border: 2rpx solid #e2ad73; border-radius: 4rpx 4rpx 99rpx 99rpx; content: ''; }
.tutu-nutrition .tutu-prop::before { position: absolute; top: 8%; left: 10%; width: 16%; height: 9%; border-radius: 100% 0 100% 0; background: #8caf79; content: ''; transform: rotate(-28deg); }
.tutu-nutrition .tutu-prop::after { position: absolute; bottom: 9%; left: 11%; width: 38%; height: 14%; border: 3rpx solid #d59457; border-top: 0; border-radius: 0 0 999rpx 999rpx; background: #fff3d9; content: ''; }
.tutu-movement > image { transform: rotate(-8deg) translateY(-2rpx); }
.tutu-movement .tutu-outfit { bottom: 20%; left: 34%; width: 34%; height: 30%; border-radius: 12% 12% 32% 32%; background: #8fa4d1; box-shadow: inset 0 4rpx 0 rgba(255,255,255,.65); transform: rotate(-8deg); }
.tutu-movement .tutu-outfit::after { position: absolute; top: 18%; left: 42%; width: 16%; height: 48%; border-radius: 99rpx; background: rgba(255,255,255,.78); content: ''; }
.tutu-movement .tutu-prop::before { position: absolute; top: 18%; left: 20%; width: 58%; height: 6rpx; border-radius: 999rpx; background: #728bc1; content: ''; transform: rotate(-7deg); }
.tutu-movement .tutu-prop::after { position: absolute; right: 6%; bottom: 21%; width: 32%; height: 5rpx; border-radius: 999rpx; background: #728bc1; box-shadow: -5rpx 0 0 2rpx #728bc1,5rpx 0 0 2rpx #728bc1; content: ''; transform: rotate(-22deg); }
.tutu-mood > image { transform: scale(.93) translateY(2rpx); }
.tutu-mood .tutu-outfit { bottom: 19%; left: 33%; width: 37%; height: 31%; border-radius: 45% 45% 32% 32%; background: #f4a9b7; }
.tutu-mood .tutu-outfit::after { position: absolute; top: 14%; left: 31%; color: #fff5f6; content: '♥'; font-size: 22rpx; line-height: 1; }
.tutu-mood .tutu-prop::after { position: absolute; top: 3%; right: 5%; color: #e46e86; content: '♥'; font-size: 23rpx; line-height: 1; text-shadow: 0 2rpx 0 #fff; }
.tutu-sleep > image { transform: rotate(7deg) translateY(3rpx); opacity: .9; }
.tutu-sleep .tutu-outfit { right: 17%; bottom: 10%; width: 55%; height: 30%; border: 2rpx solid #8f7fba; border-radius: 50% 40% 25% 25%; background: #dcd5f1; transform: rotate(6deg); }
.tutu-sleep .tutu-outfit::after { position: absolute; top: 16%; left: 15%; width: 55%; height: 3rpx; border-radius: 99rpx; background: rgba(255,255,255,.8); content: ''; }
.tutu-sleep .tutu-prop::before { position: absolute; top: 4%; left: 28%; width: 36%; height: 24%; border-radius: 100% 10% 70% 10%; background: #9c8bc5; content: ''; transform: rotate(12deg); }
.tutu-sleep .tutu-prop::after { position: absolute; top: 2%; right: 3%; color: #7f72ad; content: '☾'; font-size: 25rpx; font-weight: 700; }
.tutu-ai .tutu-prop::before { position: absolute; top: 7%; left: 23%; width: 52%; height: 20%; border: 3rpx solid #e68a91; border-radius: 50%; content: ''; transform: rotate(-5deg); }
.tutu-ai .tutu-prop::after { position: absolute; top: 3%; right: 5%; color: #e1a55e; content: '✦'; font-size: 24rpx; }
.tutu-ai .tutu-outfit { top: 25%; left: 19%; width: 58%; height: 31%; border: 3rpx solid #8e82b9; border-bottom-color: transparent; border-radius: 50% 50% 35% 35%; }
.tutu-ai .tutu-outfit::before,.tutu-ai .tutu-outfit::after { position: absolute; top: 45%; width: 12%; height: 32%; border-radius: 99rpx; background: #8e82b9; content: ''; }.tutu-ai .tutu-outfit::before { left: -9%; }.tutu-ai .tutu-outfit::after { right: -9%; }
.tutu-team > image:first-child { position: absolute; left: 5%; width: 58%; height: 80%; transform: rotate(-6deg); }
.tutu-team .tutu-buddy { position: absolute; right: 4%; display: block; width: 58%; height: 80%; transform: scaleX(-1) rotate(-6deg); }
.tutu-team .tutu-outfit { z-index: 3; bottom: 25%; left: 15%; width: 69%; height: 8%; border-radius: 99rpx; background: #efab78; transform: rotate(-3deg); }
.tutu-team .tutu-prop::after { position: absolute; top: 4%; left: 40%; color: #e67b83; content: '♥'; font-size: 19rpx; }
.tutu-learn > image { transform: translateY(-4rpx) scale(.9); }
.tutu-learn .tutu-outfit { top: 27%; left: 24%; width: 18%; height: 18%; border: 3rpx solid #6f608f; border-radius: 50%; box-shadow: 24rpx 0 0 -1rpx #fff,24rpx 0 0 2rpx #6f608f; }
.tutu-learn .tutu-outfit::after { position: absolute; top: 42%; left: 100%; width: 24rpx; height: 3rpx; background: #6f608f; content: ''; }
.tutu-learn .tutu-prop::after { position: absolute; bottom: 7%; left: 13%; width: 68%; height: 24%; border: 3rpx solid #8f7fba; border-radius: 5rpx 5rpx 10rpx 10rpx; background: linear-gradient(90deg,#fff 48%,#8f7fba 49%,#8f7fba 52%,#fff 53%); content: ''; transform: perspective(30rpx) rotateX(6deg); }
.tutu-forum > image { transform: translateX(-6rpx) scale(.94); }
.tutu-forum .tutu-outfit { right: 28%; bottom: 18%; width: 34%; height: 16%; border-radius: 99rpx; background: #e7a58e; transform: rotate(-5deg); }
.tutu-forum .tutu-prop::after { position: absolute; top: 5%; right: 1%; width: 43%; height: 27%; border: 3rpx solid #c87a66; border-radius: 999rpx; background: #fff; color: #c87a66; content: '•••'; font-size: 14rpx; font-weight: 800; line-height: 18rpx; text-align: center; }
.shortcut-title { margin-top: 16rpx; color: #704a47; font-size: 28rpx; font-weight: 700; }
.shortcut-copy { margin-top: 7rpx; color: #9f7d77; font-size: 21rpx; }
