.connections-page{min-height:100vh;background:linear-gradient(180deg,#fff8f7,#f7f2ff)}.relation-hero{padding:31rpx;border:1rpx solid #f1dce2;border-radius:34rpx;background:linear-gradient(135deg,#ffe7e9,#f2eaff);box-shadow:0 16rpx 38rpx rgba(115,72,95,.1)}.kicker{color:#c96d70;font-size:17rpx;font-weight:800;letter-spacing:3rpx}.hero-title{margin-top:8rpx;color:#684744;font-size:38rpx;font-weight:800}.hero-copy{margin-top:10rpx;color:#997873;font-size:21rpx;line-height:1.6}.relation-tabs{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.relation-tabs button{margin:0;padding:18rpx;border:1rpx solid #efdfdc;border-radius:25rpx;background:#fff;color:#9b7b75;line-height:1.4}.relation-tabs button::after,.follow-button::after,.failed button::after{border:0}.relation-tabs text{color:#b66a6b;font-size:27rpx;font-weight:800}.relation-tabs view{margin-top:3rpx;font-size:20rpx}.relation-tabs .active{border-color:#e28a89;background:#fff0ee;color:#b45f61;box-shadow:0 8rpx 20rpx rgba(188,93,97,.09)}.connection-list{margin-top:24rpx;overflow:hidden;border:1rpx solid #f0e0dc;border-radius:30rpx;background:rgba(255,255,255,.95)}.connection{display:flex;align-items:center;gap:18rpx;padding:22rpx;border-bottom:1rpx solid #f3e7e3}.connection:last-child{border-bottom:0}.person{display:flex;min-width:0;flex:1;align-items:center}.person image{width:86rpx;height:86rpx;flex:none;border:4rpx solid #fff;border-radius:50%;background:#fff0ed;box-shadow:0 6rpx 18rpx rgba(115,73,77,.1)}.person>view{min-width:0;margin-left:18rpx}.person>view>view{overflow:hidden;color:#6d4c48;font-size:27rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.person text{display:block;margin-top:5rpx;color:#bd7474;font-size:17rpx;letter-spacing:.5rpx}.follow-button{width:146rpx;flex:none;margin:0;border-radius:999rpx;background:#db7071;color:#fff;font-size:21rpx;line-height:62rpx}.follow-button.followed{background:#fff;color:#a87570;box-shadow:inset 0 0 0 1rpx #e7c8c4}.loading{padding:90rpx;color:#9c7d77;text-align:center}.failed,.empty{display:flex;min-height:50vh;flex-direction:column;align-items:center;justify-content:center;color:#9d7c76;text-align:center}.failed image,.empty image{width:220rpx;height:170rpx}.failed>view,.empty>view{color:#6f4d49;font-size:27rpx;font-weight:700}.empty text{margin-top:10rpx;font-size:20rpx}.failed button{width:260rpx;margin-top:22rpx;border-radius:999rpx;background:#dc7272;color:#fff;font-size:22rpx}
