.wallet-card { padding:42rpx; border-radius:34rpx; background:linear-gradient(135deg,#df7370,#ed9a91); color:#fff; box-shadow:0 20rpx 50rpx rgba(190,83,81,.22); }.wallet-card .label { opacity:.85; font-size:24rpx; }.balance { margin:18rpx 0 26rpx; font-size:64rpx; font-weight:800; }.balance text { margin-right:8rpx; font-size:32rpx; }.wallet-card button { width:180rpx; margin:0; background:#fff; color:#c75f61; font-size:25rpx; }.pro-card { margin-top:28rpx; padding:34rpx; border:1rpx solid #eadbc0; border-radius:34rpx; background:linear-gradient(145deg,#fffaf0,#fff); }.pro-badge { color:#9e7542; font-size:21rpx; font-weight:800; letter-spacing:3rpx; }.pro-title { margin:16rpx 0 26rpx; color:#694d42; font-size:34rpx; font-weight:800; }.benefit { margin:16rpx 0; color:#866b60; font-size:25rpx; }.pro-card button { margin-top:28rpx; background:#765f92; color:#fff; font-size:25rpx; }.note { padding:28rpx 16rpx; color:#a4857f; font-size:21rpx; line-height:1.7; }
