.tabs { display:flex; padding:8rpx; margin-bottom:24rpx; border-radius:22rpx; background:#f7eae7; }.tabs button { flex:1; margin:0; background:transparent; color:#9b736e; font-size:25rpx; }.tabs button::after { border:0; }.tabs .active { border-radius:17rpx; background:#fff; color:#c75f61; font-weight:700; box-shadow:0 5rpx 16rpx rgba(110,68,64,.08); }.notice,.post { display:flex; align-items:center; margin-bottom:18rpx; padding:24rpx; border-radius:26rpx; background:#fff; }.avatar { width:76rpx; height:76rpx; flex:none; border-radius:50%; }.notice-copy { min-width:0; flex:1; margin-left:16rpx; color:#77534f; font-size:25rpx; }.notice-copy text { color:#c65f61; font-weight:700; }.time,.post-meta { margin-top:8rpx; color:#ae8c87; font-size:20rpx; }.dot { width:16rpx; height:16rpx; border-radius:50%; background:#e35f66; }.post { display:block; }.post-meta { display:flex; justify-content:space-between; margin-top:0; }.post-content { margin-top:16rpx; color:#72504d; font-size:27rpx; line-height:1.65; }.counts { margin-top:15rpx; color:#d85e65; }.state { padding:80rpx 20rpx; color:#a37d78; text-align:center; }.state.error { color:#c45f5f; }.go { width:240rpx; margin-top:24rpx; background:#df7370; color:#fff; font-size:24rpx; }
