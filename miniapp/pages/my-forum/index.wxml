<view class="page"><view class="tabs"><button class="{{tab === 'notice' ? 'active' : ''}}" data-tab="notice" bindtap="setTab">消息提醒</button><button class="{{tab === 'posts' ? 'active' : ''}}" data-tab="posts" bindtap="setTab">我的帖子</button></view><view class="state" wx:if="{{loading}}">正在同步云端…</view><view class="state error" wx:if="{{error}}">{{error}}</view><block wx:if="{{tab === 'notice'}}"><view class="notice" wx:for="{{notifications}}" wx:key="id" data-owner="{{item.actorId}}" bindtap="openActor"><image class="avatar" src="{{item.actorAvatar || '/assets/tutu-single.svg'}}" mode="aspectFill"/><view class="notice-copy"><view><text>{{item.actorName}}</text> {{item.actionText}}</view><view class="time">{{item.timeText}}</view></view><view class="dot" wx:if="{{!item.read}}"></view></view><view class="state" wx:if="{{!loading && !notifications.length}}">暂时没有新消息</view></block><block wx:else><view class="post" wx:for="{{posts}}" wx:key="id"><view class="post-meta"><text>{{item.category || '日常分享'}}</text><text>{{item.timeText}}</text></view><view class="post-content">{{item.content}}</view><view class="counts">♥ {{item.likeCount || 0}}</view></view><view class="state" wx:if="{{!loading && !posts.length}}">你还没有发布帖子<button class="go" bindtap="goForum">去论坛分享</button></view></block></view>
