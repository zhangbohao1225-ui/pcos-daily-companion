.messages-page{min-height:100vh;background:linear-gradient(180deg,#fff8f7,#f8f3ff)}.messages-hero{display:flex;align-items:center;justify-content:space-between;padding:30rpx;border-radius:34rpx;background:linear-gradient(135deg,#f18383,#9076bd);color:#fff;box-shadow:0 16rpx 38rpx rgba(115,71,100,.14)}.messages-hero>view>text:first-child{display:block;font-size:17rpx;font-weight:700;letter-spacing:3rpx}.messages-hero>view>view{margin:6rpx 0;font-size:38rpx;font-weight:800}.messages-hero>view>text:last-child{font-size:21rpx;opacity:.88}.messages-hero image{width:150rpx;height:110rpx}.loading{padding:80rpx;color:#9b7a75;text-align:center}.thread-list{margin-top:24rpx;overflow:hidden;border:1rpx solid #f0e1dd;border-radius:32rpx;background:rgba(255,255,255,.94)}.thread{display:flex;align-items:center;box-sizing:border-box;width:100%;min-height:126rpx;margin:0;padding:22rpx;border-bottom:1rpx solid #f2e6e2;background:transparent;text-align:left}.thread:last-child{border-bottom:0}.thread::after{border:0}.thread>image{width:82rpx;height:82rpx;flex:none;border-radius:50%;background:#fff0ed}.thread-copy{min-width:0;flex:1;margin-left:20rpx}.thread-top,.thread-bottom{display:flex;align-items:center;justify-content:space-between}.thread-top text:first-child{overflow:hidden;color:#6c4b47;font-size:27rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.thread-top text:last-child{color:#b1948e;font-size:18rpx}.thread-bottom{margin-top:8rpx}.thread-bottom>text:first-child{overflow:hidden;max-width:500rpx;color:#a1817b;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.unread{min-width:34rpx;height:34rpx;padding:0 7rpx;border-radius:999rpx;background:#df6268;color:#fff;font-size:18rpx;line-height:34rpx;text-align:center}.state{display:flex;min-height:58vh;flex-direction:column;align-items:center;justify-content:center;color:#a1817b;text-align:center}.state image{width:220rpx;height:170rpx}.state-title,.state>view{color:#714e4a;font-size:29rpx;font-weight:700}.state>text{margin-top:12rpx;font-size:21rpx}.state button{width:280rpx;margin-top:26rpx;border-radius:999rpx;background:#dc7371;color:#fff;font-size:23rpx}.state button::after{border:0}
