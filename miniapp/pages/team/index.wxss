.team-page { padding-top: 26rpx; }
.line-break { display: block; }
.top-actions { display: flex; gap: 14rpx; margin-top: 24rpx; }
.top-actions button { display: flex; align-items: center; justify-content: center; flex: 1; min-height: 76rpx; margin: 0; border-radius: 999rpx; font-size: 24rpx; font-weight: 600; }
.top-actions text { margin-right: 6rpx; font-size: 30rpx; font-weight: 400; }
.join-btn { border: 1rpx solid #f1c9c0; background: rgba(255,255,255,.88); color: #c86360; }
.create-btn { background: linear-gradient(135deg,#f39a8b,#ed7b87); color: #fff; box-shadow: 0 12rpx 26rpx rgba(214,101,111,.18); }
.team-hero { position: relative; margin-top: 24rpx; overflow: hidden; border-radius: 36rpx; background: linear-gradient(145deg,#eb7382,#f08b8e); box-shadow: 0 20rpx 46rpx rgba(190,79,93,.18); }
.team-hero-image { display: block; width: 100%; height: 250rpx; }
.team-hero-wash { position: absolute; z-index: 1; top: 0; right: 0; left: 0; height: 254rpx; background: linear-gradient(180deg,rgba(235,115,130,0) 48%,rgba(235,115,130,.94) 100%); }
.team-hero-copy { position: relative; z-index: 2; width: 100%; margin-top: -18rpx; padding: 0 34rpx 36rpx; color: #fff; }
.privacy-note { display: inline-flex; padding: 10rpx 16rpx; border: 1rpx solid rgba(255,255,255,.42); border-radius: 999rpx; background: rgba(255,255,255,.10); font-size: 18rpx; white-space: nowrap; }
.empty-team { padding: 54rpx 38rpx; text-align: center; }
.empty-team-art { display: flex; width: 96rpx; height: 96rpx; align-items: center; justify-content: center; margin: 0 auto 22rpx; border-radius: 50%; background: #fff0ed; color: #d86c6d; font-size: 48rpx; }
.empty-team .muted { margin: 16rpx 0 28rpx; line-height: 1.7; }
.empty-team .primary-btn { width: 300rpx; }
.cloud-error { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 22rpx 0; padding: 18rpx; border-radius: 20rpx; background: #fff0ed; color: #a75f5c; font-size: 22rpx; }
.cloud-error button { width: 110rpx; margin: 0; padding: 0; background: #df7370; color: #fff; font-size: 21rpx; }
.hero-title { margin-top: 28rpx; font-family: "Microsoft YaHei", "微软雅黑", sans-serif; font-size: 48rpx; font-weight: 700; line-height: 1.28; }
.hero-subtitle { margin-top: 22rpx; font-size: 22rpx; line-height: 1.65; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 28rpx; }
.hero-actions button { min-height: 68rpx; margin: 0; padding: 0 20rpx; border-radius: 999rpx; font-size: 21rpx; }
.hero-main { background: #fff; color: #d2646e; }
.hero-ghost { border: 1rpx solid rgba(255,255,255,.52); background: rgba(255,255,255,.12); color: #fff; }
.action-card { border-color: #f1d1ca; background: rgba(255,255,255,.97); }
.action-card .input { margin-top: 22rpx; }
.action-card .primary-btn { width: 100%; margin-top: 16rpx; }
.close-btn { padding: 12rpx; }
.team-icon { display: flex; align-items: center; justify-content: center; width: 74rpx; height: 74rpx; border-radius: 24rpx; background: #fff0eb; font-size: 38rpx; }
.summary { margin-top: 24rpx; padding: 24rpx; border-radius: 24rpx; background: #fff1ec; color: #986f69; }
.summary text { margin-right: 8rpx; color: #c96563; font-family: "Microsoft YaHei", "微软雅黑", sans-serif; font-size: 42rpx; font-weight: 700; }
.member { display: flex; align-items: center; gap: 16rpx; margin-top: 14rpx; padding: 18rpx; border: 1rpx solid #f4e4df; border-radius: 22rpx; }
.member-avatar { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; border-radius: 50%; background: #ffe8e1; color: #c36460; }
.member-copy { flex: 1; }
.member-copy text { color: #aa8982; font-size: 21rpx; }
.share-row { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding: 22rpx; border-radius: 22rpx; background: #fff8f5; }
.share-row text { color: #ad8b84; font-size: 20rpx; }
.invite { margin-top: 18rpx; padding: 20rpx; border: 1rpx solid #f0d5ce; border-radius: 20rpx; }
.invite text { display: block; color: #ad8982; font-size: 19rpx; }
.invite-code { display: block; color: #8f5955; font-size: 28rpx; font-weight: 700; letter-spacing: 3rpx; }
.small { font-size: 29rpx; }
.encouragement { margin-top: 18rpx; }
.send { width: 100%; margin-top: 16rpx; }
.messages { margin-top: 26rpx; }
.message { margin-top: 12rpx; padding: 20rpx; border-radius: 20rpx; background: #fff5f1; color: #87635e; line-height: 1.7; }
.message text { color: #c36c66; font-size: 21rpx; }
