<view class="page article" wx:if="{{article}}"><view class="article-icon">{{article.icon}}</view><view class="tag">{{article.category}}</view><view class="title">{{article.title}}</view><view class="lead">{{article.summary}}</view><view class="paragraph" wx:for="{{article.content}}" wx:key="*this">{{item}}</view><view class="notice">提示：本文仅用于一般性健康教育。如有持续不适或紧急症状，请及时就医。</view></view>
