.checkin-hero { position: relative; display: flex; min-height: 280rpx; overflow: hidden; padding: 30rpx 24rpx 20rpx 30rpx; border: 1rpx solid #eedcea; border-radius: 34rpx; background: linear-gradient(135deg,#fff0f3,#f4efff); box-shadow: 0 16rpx 38rpx rgba(130,90,150,.09); }.checkin-copy { position: relative; z-index: 1; width: 78%; }.checkin-copy .title { font-size: 34rpx; white-space: nowrap; }.tutu-standing { position: absolute; right: -18rpx; bottom: -62rpx; width: 210rpx; height: 350rpx; }
.check-list { margin-top: 22rpx; }.check-item { display: flex; align-items: center; gap: 18rpx; margin-top: 14rpx; padding: 18rpx; border: 1rpx solid #f2dfda; border-radius: 24rpx; background: #fffaf8; }.check-item.checked { border-color: #efc3ba; background: #fff0eb; }.check-icon { flex: none; }.check-art { width: 104rpx; height: 86rpx; border-radius: 22rpx; background: linear-gradient(145deg,#fff,#fff1f3); }.check-copy { flex: 1; color: #75514d; font-size: 33rpx; font-weight: 700; letter-spacing:.5rpx; }.check-copy text { display:none; }.checkbox { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border: 2rpx solid #e8c7c0; border-radius: 50%; color: #fff; }.checked .checkbox { border-color: #df7370; background: #df7370; }
.tutu-check { position: relative; display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border: 2rpx solid #fff; border-radius: 22rpx; background: linear-gradient(145deg,#fff,#ffe9ed); box-shadow: 0 6rpx 14rpx rgba(180,87,102,.12); }
.tutu-check image { width: 55rpx; height: 61rpx; }.tutu-check .tutu-outfit { position: absolute; z-index: 2; pointer-events: none; }.tutu-check .tutu-prop { position: absolute; z-index: 2; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none; }
.tutu-nutrition image { transform: rotate(3deg); }.tutu-nutrition .tutu-outfit { bottom: 11rpx; left: 24rpx; width: 23rpx; height: 25rpx; border: 2rpx solid #d59457; border-radius: 45% 45% 25% 25%; background: #fff0d2; }.tutu-nutrition .tutu-prop::before { position: absolute; top: 7rpx; left: 4rpx; width: 14rpx; height: 8rpx; border-radius: 100% 0 100% 0; background: #8caf79; content: ''; transform: rotate(-28deg); }.tutu-nutrition .tutu-prop::after { position: absolute; bottom: 7rpx; left: 5rpx; width: 27rpx; height: 9rpx; border: 2rpx solid #d59457; border-top: 0; border-radius: 0 0 99rpx 99rpx; background: #fff3d9; content: ''; }
.tutu-movement image { transform: rotate(-8deg); }.tutu-movement .tutu-outfit { bottom: 13rpx; left: 23rpx; width: 23rpx; height: 20rpx; border-radius: 5rpx 5rpx 10rpx 10rpx; background: #8fa4d1; transform: rotate(-8deg); }.tutu-movement .tutu-prop::before { position: absolute; top: 14rpx; left: 14rpx; width: 38rpx; height: 5rpx; border-radius: 99rpx; background: #728bc1; content: ''; transform: rotate(-7deg); }.tutu-movement .tutu-prop::after { position: absolute; right: 4rpx; bottom: 15rpx; width: 22rpx; height: 4rpx; border-radius: 99rpx; background: #728bc1; box-shadow: -4rpx 0 0 1rpx #728bc1,4rpx 0 0 1rpx #728bc1; content: ''; transform: rotate(-22deg); }
.tutu-mood image { transform: scale(.93); }.tutu-mood .tutu-outfit { bottom: 13rpx; left: 22rpx; width: 25rpx; height: 20rpx; border-radius: 45% 45% 30% 30%; background: #f4a9b7; }.tutu-mood .tutu-outfit::after { position: absolute; top: 2rpx; left: 8rpx; color: #fff; content: '♥'; font-size: 12rpx; }.tutu-mood .tutu-prop::after { position: absolute; top: 2rpx; right: 2rpx; color: #e46e86; content: '♥'; font-size: 21rpx; }.tutu-sleep image { transform: rotate(7deg); opacity: .9; }.tutu-sleep .tutu-outfit { right: 9rpx; bottom: 7rpx; width: 38rpx; height: 20rpx; border: 2rpx solid #8f7fba; border-radius: 50% 40% 25% 25%; background: #dcd5f1; transform: rotate(6deg); }.tutu-sleep .tutu-prop::before { position: absolute; top: 3rpx; left: 20rpx; width: 29rpx; height: 17rpx; border-radius: 100% 10% 70% 10%; background: #9c8bc5; content: ''; transform: rotate(12deg); }.tutu-sleep .tutu-prop::after { position: absolute; top: 1rpx; right: 1rpx; color: #7f72ad; content: '☾'; font-size: 22rpx; }
.team-checkin-entry { display: flex; align-items: center; gap: 17rpx; min-height: 118rpx; margin-top: 24rpx; padding: 18rpx 24rpx 18rpx 16rpx; border: 1rpx solid #ecdde8; border-radius: 28rpx; background: linear-gradient(135deg,#fff8f5,#f7effd); box-shadow: 0 12rpx 30rpx rgba(129,95,154,.08); }.team-entry-icon { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 82rpx; flex: none; overflow: hidden; border-radius: 22rpx; background: linear-gradient(145deg,#fff,#fff0f2); }.team-entry-icon image { width: 86rpx; height: 76rpx; }.team-entry-copy { min-width: 0; flex: 1; color: #74504c; font-size: 27rpx; font-weight: 700; }.team-entry-copy text { display: block; margin-top: 6rpx; color: #9d7d84; font-size: 20rpx; font-weight: 400; line-height: 1.5; }.team-entry-arrow { color: #bd6b70; font-size: 42rpx; }
.picker-row { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 4rpx; border-bottom: 1rpx solid #f5e7e2; color: #785551; }.picker-value { color: #c06c66; }.note { margin-top: 24rpx; }.save { margin-top: 24rpx; width: 100%; }
.modal-mask,.celebration-mask { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; justify-content: center; padding: 24rpx; background: rgba(82,50,52,.42); }
.editor-card { width: 100%; max-height: 88vh; padding: 30rpx; overflow-y: auto; border-radius: 36rpx 36rpx 24rpx 24rpx; background: #fffdfb; box-shadow: 0 -18rpx 54rpx rgba(94,54,58,.16); }
.editor-head { display: flex; align-items: center; gap: 18rpx; padding-bottom: 24rpx; border-bottom: 1rpx solid #f5e5e0; }.editor-icon { width: 76rpx; height: 76rpx; border-radius: 24rpx; }.editor-head .section-title { font-size: 32rpx; }
.editor-body { padding: 4rpx 0 12rpx; }.field-label { margin-top: 24rpx; margin-bottom: 12rpx; color: #79534f; font-size: 24rpx; font-weight: 600; }.field-label text { color: #b4938d; font-size: 20rpx; font-weight: 400; }.value-input { display: flex; align-items: center; height: 84rpx; padding: 0 22rpx; border: 1rpx solid #efd6cf; border-radius: 20rpx; background: #fffaf8; }.value-input input { flex: 1; height: 100%; color: #704d49; font-size: 29rpx; }.value-input text { color: #a57f78; font-size: 23rpx; }.choice-picker { display: flex; align-items: center; justify-content: space-between; min-height: 84rpx; padding: 0 22rpx; border: 1rpx solid #efd6cf; border-radius: 20rpx; background: #fffaf8; color: #704d49; font-size: 25rpx; }.choice-picker text { color: #c46a65; }.editor-note { min-height: 140rpx; }.editor-actions { display: grid; grid-template-columns: 1fr 1.25fr; gap: 14rpx; margin-top: 18rpx; }.editor-actions button { width: 100%; }.remove-record { margin-top: 16rpx; background: transparent; color: #b98078; font-size: 21rpx; }
.celebration-mask { z-index: 1100; align-items: center; padding: 34rpx; background: rgba(91,54,58,.48); }.celebration-card { position: relative; width: 100%; overflow: hidden; padding: 44rpx 34rpx 30rpx; border: 4rpx solid rgba(255,255,255,.9); border-radius: 46rpx; background: linear-gradient(160deg,#fffaf3,#fff0f2 54%,#faedf8); text-align: center; box-shadow: 0 30rpx 90rpx rgba(120,62,70,.28); }.celebration-title { position: relative; z-index: 2; color: #e86475; font-size: 38rpx; font-weight: 800; }.celebration-tutu { width: 260rpx; height: 310rpx; margin-top: 8rpx; border-radius: 34rpx; }.celebration-message { color: #8d6863; font-size: 23rpx; line-height: 1.7; }.celebration-progress { height: 12rpx; margin: 22rpx 10rpx 8rpx; overflow: hidden; border-radius: 999rpx; background: #f8dfe0; }.celebration-progress view { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#f19a8d,#ea6d7d); }.celebration-count { color: #a17b75; font-size: 20rpx; }.celebration-button { width: 100%; min-height: 84rpx; margin-top: 24rpx; border-radius: 999rpx; background: linear-gradient(90deg,#f07884,#e95f76); color: #fff; font-size: 26rpx; font-weight: 700; }.team-link { margin-top: 8rpx; background: transparent; color: #bf6463; font-size: 22rpx; }.spark { position: absolute; color: #eda07b; }.spark-one { top: 34rpx; left: 34rpx; font-size: 34rpx; }.spark-two { top: 110rpx; right: 36rpx; color: #a998c7; font-size: 29rpx; }.spark-three { top: 188rpx; left: 45rpx; color: #b9cead; font-size: 18rpx; }
