.chat-page{min-height:100vh;background:linear-gradient(180deg,#fff8f7,#f7f2ff)}.chat-head{display:flex;align-items:center;padding:20rpx 26rpx;border-bottom:1rpx solid #f0dfdc;background:rgba(255,255,255,.9)}.chat-head image{width:74rpx;height:74rpx;border-radius:50%;background:#fff0ed}.chat-head>view{min-width:0;flex:1;margin-left:18rpx}.chat-head>view>view{overflow:hidden;color:#684744;font-size:27rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.chat-head text{color:#b37675;font-size:17rpx}.chat-head button{width:auto;margin:0;padding:12rpx 18rpx;background:#fff0ed;color:#ad6263;font-size:22rpx;line-height:1}.chat-head button::after,.composer button::after,.failed button::after{border:0}.messages{box-sizing:border-box;height:calc(100vh - 230rpx);padding:24rpx 24rpx 40rpx}.safety-note{margin:0 auto 28rpx;padding:13rpx 20rpx;border-radius:999rpx;background:#f0eafb;color:#8b7aa4;font-size:18rpx;text-align:center}.message-row{display:flex;margin:18rpx 0;justify-content:flex-start}.message-row.mine{justify-content:flex-end}.bubble{max-width:72%;padding:20rpx 22rpx 13rpx;border-radius:26rpx 26rpx 26rpx 8rpx;background:#fff;color:#704f4b;font-size:25rpx;line-height:1.6;box-shadow:0 8rpx 26rpx rgba(99,67,71,.07)}.mine .bubble{border-radius:26rpx 26rpx 8rpx 26rpx;background:linear-gradient(135deg,#e88484,#c8708a);color:#fff}.bubble text{display:block;margin-top:6rpx;color:#b59892;font-size:16rpx;text-align:right}.mine .bubble text{color:rgba(255,255,255,.75)}.empty{padding:120rpx 30rpx;color:#a3847e;font-size:22rpx;text-align:center}.composer{position:fixed;right:0;bottom:0;left:0;display:flex;gap:14rpx;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid #eedfdb;background:rgba(255,250,249,.96)}.composer input{min-width:0;flex:1;height:76rpx;padding:0 24rpx;border-radius:999rpx;background:#fff;color:#684844;font-size:23rpx}.composer button{width:126rpx;margin:0;border-radius:999rpx;background:#d96f72;color:#fff;font-size:23rpx;line-height:76rpx}.composer button[disabled]{background:#e8cecd;color:#fff}.loading,.failed{display:flex;min-height:65vh;flex-direction:column;align-items:center;justify-content:center;color:#9b7c76;text-align:center}.failed image{width:190rpx;height:210rpx}.failed button{width:260rpx;margin-top:20rpx;border-radius:999rpx;background:#dc7371;color:#fff;font-size:22rpx}
