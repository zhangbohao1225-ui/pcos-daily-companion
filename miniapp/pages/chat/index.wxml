<view class="chat-page">
  <view class="chat-head" wx:if="{{other}}"><image src="{{other.avatarUrl || '/assets/tutu-single.svg'}}" mode="aspectFill"/><view><view>{{other.displayName}}</view><text>{{other.publicId}}</text></view><button bindtap="more">•••</button></view>
  <view class="loading" wx:if="{{loading}}">正在打开私信…</view>
  <view class="failed" wx:elif="{{failed}}"><image src="/assets/tutu-single.svg" mode="aspectFit"/><view>这段私信暂时打不开</view><button bindtap="load">再试一次</button></view>
  <scroll-view class="messages" scroll-y scroll-with-animation scroll-into-view="{{scrollId}}" wx:else>
    <view class="safety-note">请保护个人信息；遇到不适内容可从右上角举报。</view>
    <view id="message-{{item.id}}" class="message-row {{item.isMine ? 'mine' : ''}}" wx:for="{{messages}}" wx:key="id"><view class="bubble">{{item.content}}<text>{{item.timeText}}</text></view></view>
    <view class="empty" wx:if="{{!messages.length}}">说声你好，开启一段温柔的对话吧。</view>
  </scroll-view>
  <view class="composer" wx:if="{{!failed}}"><input value="{{draft}}" maxlength="500" confirm-type="send" bindinput="input" bindconfirm="send" placeholder="写下想说的话…"/><button loading="{{sending}}" disabled="{{!draft || sending}}" bindtap="send">发送</button></view>
</view>
