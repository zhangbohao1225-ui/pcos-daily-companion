page {
  min-height: 100%;
  background: linear-gradient(180deg, #fff8f8 0%, #fffdf9 48%, #fff8f4 100%);
  color: #684845;
  font-family: "Microsoft YaHei", "微软雅黑", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, textarea, picker, navigator, label { box-sizing: border-box; font-family: "Microsoft YaHei", "微软雅黑", sans-serif !important; }
button::after { border: none; }
.page { min-height: 100vh; padding: 30rpx 28rpx 64rpx; }
.kicker { color: #c57a72; font-size: 21rpx; font-weight: 700; letter-spacing: 4rpx; }
.title { margin-top: 10rpx; color: #69423f; font-family: "Microsoft YaHei", "微软雅黑", sans-serif; font-size: 48rpx; font-weight: 700; line-height: 1.25; }
.subtitle { margin-top: 14rpx; color: #9b7771; font-size: 25rpx; line-height: 1.7; }
.card { margin-top: 24rpx; padding: 30rpx; border: 1rpx solid rgba(239,207,202,.78); border-radius: 32rpx; background: rgba(255,255,255,.94); box-shadow: 0 16rpx 44rpx rgba(165,83,91,.08); }
.soft-card { padding: 24rpx; border-radius: 26rpx; background: #fff1ec; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.section-title { color: #744e4a; font-family: "Microsoft YaHei", "微软雅黑", sans-serif; font-size: 34rpx; font-weight: 700; }
.muted { color: #a48680; font-size: 23rpx; line-height: 1.6; }
.primary-btn { display: flex; align-items: center; justify-content: center; min-height: 84rpx; margin: 0; border-radius: 24rpx; background: linear-gradient(135deg,#ef8880,#db696b); color: #fff; font-size: 27rpx; font-weight: 600; }
.secondary-btn { display: flex; align-items: center; justify-content: center; min-height: 78rpx; margin: 0; border: 1rpx solid #efcfc7; border-radius: 22rpx; background: #fff; color: #bd625e; font-size: 25rpx; }
.text-btn { margin: 0; padding: 0; background: transparent; color: #c56661; font-size: 24rpx; line-height: 1.4; }
.input, .textarea { width: 100%; border: 1rpx solid #efd6cf; border-radius: 22rpx; background: #fffaf8; color: #704d49; font-size: 27rpx; }
.input { height: 84rpx; padding: 0 24rpx; }
.textarea { min-height: 180rpx; padding: 22rpx; line-height: 1.6; }
.tag { display: inline-flex; align-items: center; padding: 8rpx 16rpx; border-radius: 999rpx; background: #ffe8e1; color: #c36561; font-size: 21rpx; }
.divider { height: 1rpx; margin: 24rpx 0; background: #f5e5e0; }
.empty { padding: 54rpx 24rpx; text-align: center; color: #a88882; font-size: 25rpx; }
